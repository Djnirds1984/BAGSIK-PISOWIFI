# ---------------------------------------------------------------------------
# BAGSIK PISOWIFI configuration
# Copy to .env and edit. Every key is prefixed with BAGSIK_.
# On a Raspberry Pi appliance this file normally lives in /etc/bagsik/bagsik.env
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
BAGSIK_SECRET_KEY=change-me-before-going-live
BAGSIK_DB_PATH=./data/bagsik.db
BAGSIK_TIMEZONE=Asia/Manila
BAGSIK_PORTAL_URL=http://10.0.0.1

# --- Bootstrap admin (only used when the database has no admin yet) ---------
BAGSIK_ADMIN_USER=admin
BAGSIK_ADMIN_PASSWORD=bagsik123
BAGSIK_SESSION_HOURS=12

# --- Network ----------------------------------------------------------------
# Router driver: local | mock
#   local - this box IS the system: it serves Wi-Fi, DHCP, routing, shaping
#           (nftables + tc). Runs on any Linux SBC or mini PC.
#   mock  - no hardware, simulated traffic (development on Windows/Mac)
BAGSIK_ROUTER_DRIVER=mock
# "auto" lets the app detect them: the default-route NIC becomes the uplink,
# the remaining NIC with an IPv4 address (Wi-Fi preferred) becomes the LAN.
# Override only when detection picks the wrong one (e.g. wlan0 / eth0 / end0).
BAGSIK_LAN_IFACE=auto
BAGSIK_WAN_IFACE=auto
BAGSIK_LAN_CIDR=auto
BAGSIK_ENFORCE_SECONDS=10

# --- Coin acceptor ----------------------------------------------------------
# Coin driver: mock | gpio
#   mock - kiosk page exposes a "simulate coin" panel (development only)
#   gpio - pulse counting on a Raspberry Pi GPIO pin
BAGSIK_COIN_DRIVER=mock
BAGSIK_GPIO_PIN=17
# Value of ONE pulse, in centavos (100 = 1 peso). Most CH-926 style acceptors
# can be programmed to emit 1 pulse per peso.
BAGSIK_COIN_PULSE_CENTAVOS=100
# A burst of pulses counts as one coin when the line stays quiet this long.
BAGSIK_COIN_IDLE_SECONDS=1.2
# How long an "Insert Coin" tap keeps the slot open before it closes itself.
# One transaction at a time: the slot is shut until a portal device arms it.
BAGSIK_COIN_ARM_SECONDS=120

# --- Development ------------------------------------------------------------
# Port used by run.py (the systemd unit binds port 80 directly).
BAGSIK_PORT=8080
# Simulated per-session download rate for the mock router driver (kbps).
BAGSIK_MOCK_KBPS=240
# Exposes /admin/dev/* helpers and the kiosk coin simulator.
BAGSIK_DEV_MODE=true
